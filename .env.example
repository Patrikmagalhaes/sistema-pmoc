# Conexão da aplicação (papel app_rw, sem BYPASSRLS). Pooler em modo transação no Supabase.
DATABASE_URL=postgres://app_rw:app_rw@localhost:5432/pmoc
# Conexão do dono do esquema (migrações). Nunca usada em runtime.
DATABASE_OWNER_URL=postgres://pmoc_owner:pmoc_owner@localhost:5432/pmoc
# Better Auth: segredo com 32+ caracteres (gere com `openssl rand -base64 32`).
BETTER_AUTH_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais
# URL pública do sistema (links de e-mail). Em produção, https.
APP_URL=http://localhost:3000
# Cabeçalhos de IP confiáveis (SEG-68), separados por vírgula.
AUTH_IP_HEADERS=x-real-ip
# LG-25: canal do titular (privacidade@{dominio}) [A VALIDAR: endereço]. Opcional.
# PRIVACIDADE_EMAIL=privacidade@exemplo.com.br
# 05 §3.13 / DM-11: chave do certificado do RT, 32 bytes em base64 (gere com `openssl rand -base64 32`).
# Sem ela, o envio do certificado (TL-103) recusa. Em produção, só na Vercel.
CERT_ENCRYPTION_KEY=
# Pasta do armazenamento local de arquivos em desenvolvimento (padrão: tmp/armazenamento).
# STORAGE_DEV_DIR=tmp/armazenamento
