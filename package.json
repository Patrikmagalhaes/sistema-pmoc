{
  "name": "pmoc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:spike": "vitest run --project spike",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx --conditions=react-server db/seed/index.ts",
    "adm:primeiro": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx db/primeiro-adm.ts"
  },
  "dependencies": {
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "next-safe-action": "8.7.3",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "16.15.0-beta.19",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
