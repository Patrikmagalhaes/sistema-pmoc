{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!.next",
      "!node_modules",
      "!db/migrations/meta",
      "!next-env.d.ts",
      "!test-results",
      "!playwright-report",
      "!tests/.tmp-mod02"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/modules/*/**", "!@/modules/*/index"],
                "message": "MOD-02: importe outro módulo só pelo index.ts (@/modules/<modulo>)."
              }
            ]
          }
        }
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
